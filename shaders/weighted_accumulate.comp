#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer SourceBuffer {
    float source_values[];
};

layout(std430, set = 0, binding = 1) buffer AccumulatorBuffer {
    float accumulator_values[];
};

layout(push_constant) uniform Params {
    uint count;
    float weight;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.count) {
        return;
    }

    accumulator_values[index] += params.weight * source_values[index];
}
