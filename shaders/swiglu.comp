#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer GateBuffer {
    float gate[];
};

layout(std430, set = 0, binding = 1) readonly buffer UpBuffer {
    float up[];
};

layout(std430, set = 0, binding = 2) writeonly buffer OutputBuffer {
    float output_values[];
};

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= params.count) {
        return;
    }

    float g = gate[index];
    float silu = g / (1.0 + exp(-g));
    output_values[index] = silu * up[index];
}
